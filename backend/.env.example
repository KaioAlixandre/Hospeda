# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Token de operação (header x-admin-token) — mesma regra de força do JWT
ADMIN_TOKEN=

PORT=3333

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/hospeda"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="USER"
DATABASE_PASSWORD="PASSWORD"
DATABASE_NAME="hospeda"

# Fuso do hotel para diárias e dashboard (dia civil, não UTC do servidor)
HOTEL_TIMEZONE=America/Sao_Paulo

# API de mensagens (Z-API / REST)
MESSAGING_API_URL=http://localhost:3000
MESSAGING_INSTANCE_ID=
MESSAGING_TOKEN=
MESSAGING_CLIENT_TOKEN=
# z-api = /instances/{id}/token/{token}/send-text
# rest = /messages/text
MESSAGING_STYLE=z-api
MESSAGING_PROPERTY_NAME=StayDesck

# Conta Send-API (cria/conecta instâncias por hotel)
SEND_API_BASE_URL=https://api.kaioalixandre.com.br
SEND_API_EMAIL=
SEND_API_PASSWORD=
# SEND_API_ACCESS_TOKEN=

# Cloudinary (upload de fotos de quartos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Segurança HTTP (CORS vazio = qualquer origem — necessário para o app desktop)
CORS_ORIGINS=
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=10

CATALOG_PUBLIC_BASE_URL=https://staydesk.com.br

# Dias de tolerância após o vencimento do plano
PLAN_GRACE_DAYS=5

# Stripe (assinaturas Simples/Pro/Plus) — deixe vazio para desligar e usar só admin/WhatsApp
