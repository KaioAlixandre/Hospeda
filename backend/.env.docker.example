# Copie para .env na pasta backend antes de subir com Docker:
#   cp .env.docker.example .env

PORT=3333

MYSQL_ROOT_PASSWORD=troque-esta-senha-root
DATABASE_USER=hospeda
DATABASE_PASSWORD=troque-esta-senha
DATABASE_NAME=hospeda

# API de mensagens (opcional — use o IP/host acessível pelo container)
MESSAGING_API_URL=http://host.docker.internal:3000
MESSAGING_INSTANCE_ID=
MESSAGING_TOKEN=
MESSAGING_CLIENT_TOKEN=
MESSAGING_STYLE=z-api
MESSAGING_PROPERTY_NAME=Hospeda

JWT_SECRET=change-me-in-production

# Conta Send-API
SEND_API_BASE_URL=https://api.kaioalixandre.com.br
SEND_API_EMAIL=
SEND_API_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
