generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Livre, reservado, ocupado, limpeza, manutenção
enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
}

/// Pendente, confirmada, cancelada, concluída
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReservationSource {
  DESK
  ONLINE
}

enum ChargeType {
  ROOM
  MINIBAR
  RESTAURANT
  LAUNDRY
  SERVICE
  OTHER
  DISCOUNT
}

/// Onde o lançamento entra na conta — fixo, é o que o buildBill enxerga
enum ChargeGroup {
  CONSUMPTION
  SERVICE
  DISCOUNT
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum Plan {
  SIMPLES
  PRO
  PLUS
}

/// Situação da assinatura (hoje controlada à mão)
enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Conta do hotel (login do proprietário)
model Hotel {
  id           String   @id @default(cuid())
  /// Nome do estabelecimento
  name         String
  /// Nome do proprietário
  ownerName    String
  /// CNPJ do estabelecimento (somente dígitos)
  cnpj         String?  @db.VarChar(14)
  /// Telefone/WhatsApp (login)
  phone        String   @unique
  passwordHash String
  /// URL da logo (Cloudinary)
  logoUrl      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?  @db.VarChar(2)
  zipCode      String?
  /// Credenciais da instância Send-API / WhatsApp
  messagingInstanceId  String?
  messagingToken       String?
  messagingClientToken String?

  plan          Plan       @default(SIMPLES)
  planStatus    PlanStatus @default(ACTIVE)
  /// Até quando o plano está pago (null = sem vencimento, ex.: cortesia)
  planPaidUntil DateTime?  @db.Date
  /// Anotação interna: "pagou PIX 05/10", "teste 15 dias"
  planNotes     String?    @db.Text

  /// IDs Stripe (assinatura online)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  /// Identificador do hotel no link público: /h/<slug>
  slug            String?  @unique
  /// Catálogo no ar (o hotel liga/desliga; só vale no PLUS)
  catalogEnabled  Boolean  @default(false)
  /// Texto de boas-vindas e regras que aparecem no site
  catalogHeadline String?  @db.Text
  catalogRules    String?  @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomTypes         RoomType[]
  rooms             Room[]
  guests            Guest[]
  reservations      Reservation[]
  zeladores         Zelador[]
  planEvents        PlanEvent[]
  chargeCategories  ChargeCategory[]
  products          Product[]

  @@index([name])
}

/// Histórico de mudança de plano
model PlanEvent {
  id         String      @id @default(cuid())
  hotelId    String
  fromPlan   Plan?
  toPlan     Plan
  fromStatus PlanStatus?
  toStatus   PlanStatus
  paidUntil  DateTime?   @db.Date
  note       String?     @db.Text
  /// Quem fez a mudança: "admin" hoje, "webhook:asaas" amanhã
  actor      String
  createdAt  DateTime    @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([createdAt])
}

/// Tipo de quarto (solteiro, casal, família…)
model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  description String?  @db.Text
  capacity    Int
  basePrice   Decimal  @db.Decimal(10, 2)
  /// Ex.: ["Wi-Fi", "TV", "Ar-condicionado"]
  amenities   Json     @default("[]")
  /// URLs das fotos do tipo
  photos      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model Room {
  id         String     @id @default(cuid())
  hotelId    String
  /// Número/identificação do quarto
  number     String
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  roomTypeId String
  /// Capacidade específica (null = usa a do tipo)
  capacity   Int?
  /// Preço por diária específico (null = usa o do tipo)
  dailyPrice Decimal?   @db.Decimal(10, 2)
  /// Comodidades extras/específicas do quarto
  amenities  Json       @default("[]")
  /// Fotos específicas do quarto
  photos     Json       @default("[]")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  reservations Reservation[]

  @@unique([hotelId, number])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([status])
}

model Guest {
  id           String   @id @default(cuid())
  hotelId      String
  name         String
  phone        String?
  /// CPF (somente dígitos, único por hotel; opcional até o check-in)
  cpf          String?
  email        String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?  @db.VarChar(2)
  zipCode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([hotelId, cpf])
  @@index([hotelId])
  @@index([email])
  @@index([phone])
  @@index([name])
}

model Reservation {
  id           String            @id @default(cuid())
  hotelId      String
  code         String            @unique
  guestId      String
  roomTypeId   String
  roomId       String?
  checkInDate  DateTime          @db.Date
  checkOutDate DateTime          @db.Date
  /// Quantidade de hóspedes
  guests       Int               @default(1)
  status       ReservationStatus @default(PENDING)
  source       ReservationSource @default(DESK)
  /// Reserva online cai sozinha se o hotel não confirmar até aqui
  expiresAt    DateTime?
  nightlyRate  Decimal           @db.Decimal(10, 2)
  /// Quartos selecionados [{ roomId, roomTypeId, guests, nightlyRate, ... }]
  roomSelection Json             @default("[]")
  notes        String?           @db.Text
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest    Guest         @relation(fields: [guestId], references: [id])
  roomType RoomType      @relation(fields: [roomTypeId], references: [id])
  room     Room?         @relation(fields: [roomId], references: [id])
  charges  FolioCharge[]
  payments Payment[]

  @@index([hotelId])
  @@index([guestId])
  @@index([roomTypeId])
  @@index([roomId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@index([expiresAt])
}

/// Categoria de lançamento, cadastrada pelo hotel
model ChargeCategory {
  id        String      @id @default(cuid())
  hotelId   String
  name      String
  group     ChargeGroup
  /// Chave de ícone que o app resolve (mesmo padrão do ROOM_STATUS_ICON)
  icon      String?
  active    Boolean     @default(true)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  products Product[]
  charges  FolioCharge[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model Product {
  id         String   @id @default(cuid())
  hotelId    String
  categoryId String
  name       String
  /// Código interno ou de barras, opcional
  code       String?
  price      Decimal  @db.Decimal(10, 2)
  /// Unidade mostrada na tela: un, gf, kg, porção
  unit       String?
  active     Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category ChargeCategory @relation(fields: [categoryId], references: [id])
  charges  FolioCharge[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([categoryId])
  @@index([active])
}

model FolioCharge {
  id            String     @id @default(cuid())
  reservationId String
  type          ChargeType
  description   String
  amount        Decimal    @db.Decimal(10, 2)
  categoryId    String?
  /// null = lançamento digitado à mão
  productId     String?
  quantity      Int        @default(1)
  /// Preço congelado no momento do lançamento
  unitPrice     Decimal?   @db.Decimal(10, 2)
  postedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  category    ChargeCategory? @relation(fields: [categoryId], references: [id])
  product     Product?        @relation(fields: [productId], references: [id])

  @@index([reservationId])
  @@index([categoryId])
  @@index([productId])
}

/// Zelador da equipe de limpeza
model Zelador {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([name])
  @@index([phone])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  cancelledAt   DateTime?
  refundedAt    DateTime?
  notes         String?       @db.Text
  /// Se for estorno, aponta para o pagamento original
  refundOfId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  refundOf    Payment?      @relation("PaymentRefunds", fields: [refundOfId], references: [id])
  refunds     Payment[]     @relation("PaymentRefunds")

  @@index([reservationId])
  @@index([status])
  @@index([refundOfId])
}
